{
  "name": "censorbot",
  "version": "1.0.0",
  "private": true,
  "description": "CensorBot for Discord",
  "keywords": [
    "censor",
    "bot",
    "discord"
  ],
  "homepage": "https://github.com/chump29/censorbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/censorbot.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "scripts": {
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:*,lcov-total\"",
    "dev": "bun run --bun --watch index.ts",
    "env": "bun run --bun utils/env.ts",
    "env:test": "NODE_ENV=test bun run --bun utils/env.ts",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:ci": "bun run lint:biome:ci && bun run lint:ts",
    "lint:spell": "bun run --bun cspell --dot .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun .husky/prepare.min.mjs",
    "prod": "bun run --bun index.ts",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bunx --bun cve-lite-cli --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "test": "bun test --isolate --dots --preload ./tests/setup.ts --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/setup.ts --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/setup.ts --bail",
    "test:full": "bun test --isolate --preload ./tests/setup.ts --bail",
    "updates": "bunx --bun npm-check-updates --dep prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --dot --no-must-find-files",
    "*.{json,md,ts,yaml}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings"
  },
  "dependencies": {
    "@jarrodek/pluralize": "^1.0.2",
    "@postfmly/checkrate": "^2.0.8",
    "@postfmly/logger": "^1.2.4",
    "@postfmly/logoserver": "^1.3.21",
    "@postfmly/types": "^1.0.10",
    "better-profane-words": "^1.0.7",
    "discord.js": "^14.27.0",
    "envalid": "^9.0.0",
    "magic-regexp": "^0.11.2",
    "ts-pattern": "^5.9.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@postfmly/config": "^1.6.13",
    "expect-type": "^1.4.0",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "@jarrodek/pluralize@1.0.2": "patches/@jarrodek%2Fpluralize@1.0.2.patch",
    "better-profane-words@1.0.7": "patches/better-profane-words@1.0.7.patch"
  }
}
